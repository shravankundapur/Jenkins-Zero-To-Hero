pipeline {

    agent any

    environment {
        DOCKER_IMAGE = "shravansp9/todo-app"
        GITOPS_REPO = "https://github.com/shravankundapur/Jenkins-Zero-To-Hero.git"
    }

    stages {

        stage('Checkout') {
            steps {
                git credentialsId: 'github-credentials',
                    url: 'https://github.com/shravankundapur/cicd-end-to-end',
                    branch: 'main'
            }
        }

        stage('Build Docker') {
            steps {
                sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .'
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    passwordVariable: 'DOCKER_PASSWORD',
                    usernameVariable: 'DOCKER_USERNAME'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                        docker logout
                    '''
                }
            }
        }

        stage('Update GitOps Manifest') {
            steps {
                dir('gitops') {

                    git credentialsId: 'github-credentials',
                        url: "${GITOPS_REPO}",
                        branch: 'main'

                    sh '''
                        sed -i "s|image: ${DOCKER_IMAGE}:.*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|" python-jenkins-argocd-k8s/deploy/deploy.yaml

                        git config user.name "jenkins"
                        git config user.email "jenkins@example.com"

                        git add python-jenkins-argocd-k8s/deploy/deploy.yaml
                        git commit -m "Update Todo image to ${BUILD_NUMBER}"
                    '''

                    withCredentials([usernamePassword(
                        credentialsId: 'github-gitops-write',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )]) {
                        sh '''
                            set +x

                            cat > git-askpass.sh <<'EOF'
#!/bin/sh
case "$1" in
    *Username*) echo "$GIT_USERNAME" ;;
    *Password*) echo "$GIT_PASSWORD" ;;
esac
EOF

                            chmod 700 git-askpass.sh

                            trap 'rm -f git-askpass.sh' EXIT

                            GIT_ASKPASS=./git-askpass.sh \
                            GIT_TERMINAL_PROMPT=0 \
                            git push origin main
                        '''
                    }
                }
            }
        }
    }
}
