pipeline {
    agent none

    stages {

        stage('Back-end - Java Application') {
            agent {
                docker {
                    image 'maven:3.8.1-adoptopenjdk-11'
                }
            }

            steps {
                sh '''
                    echo "Creating Java application..."

                    cat > Hello.java <<'EOF'
public class Hello {
    public static void main(String[] args) {
        System.out.println("Hello from Java Application!");
        System.out.println("Running inside Jenkins Docker Agent.");
    }
}
EOF

                    echo "Compiling Java application..."
                    javac Hello.java

                    echo "Running Java application..."
                    java Hello
                '''
            }
        }

        stage('Front-end - Node.js Application') {
            agent {
                docker {
                    image 'node:16-alpine'
                }
            }

            steps {
                sh '''
                    echo "Creating Node.js application..."

                    cat > app.js <<'EOF'
const message = "Hello from Node.js Application!";
console.log(message);
console.log("Running inside Jenkins Docker Agent.");
EOF

                    echo "Running Node.js application..."
                    node app.js
                '''
            }
        }
    }
}
